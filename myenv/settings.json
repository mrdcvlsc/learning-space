{
    "editor.detectIndentation": false,
    "editor.fontFamily": "'Monaspace Argon', monospace",
    "window.zoomLevel": -0.5,

    "[typescript]": {
        "editor.tabSize": 2
    },

    "[javascript]": {
        "editor.tabSize": 2
    },

    "[jsx-tags]": {
        "editor.tabSize": 2
    },

    "[jsx]": {
        "editor.tabSize": 2
    },

    "[json]": {
        "editor.tabSize": 2
    },

    "[html]": {
        "editor.tabSize": 2
    },
    
    "workbench.colorCustomizations": {
        "statusBar.background": "#ffffff",
        "statusBar.foreground": "#000000"
    },
    
    "editor.insertSpaces": true,

    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "*.mutable": {
                "underline": false,
            }
        }
    },
    "rust-analyzer.inlayHints.chainingHints.enable": false,
    "rust-analyzer.inlayHints.closingBraceHints.enable": false,
    "rust-analyzer.inlayHints.parameterHints.enable": false,
    "rust-analyzer.inlayHints.renderColons": false,
    "rust-analyzer.inlayHints.typeHints.enable": false,
    "C_Cpp.intelliSenseEngine": "disabled", // default

    "clangd.restartAfterCrash": true,
    "clangd.path": "C:\\Program Files\\LLVM\\bin\\clangd.exe",
    
    "git.openRepositoryInParentFolders": "never",
    "yaml.schemas": {
        "file:///${userHome}/.vscode/extensions/docsmsft.docs-yaml-1.0.5/dist/toc.schema.json": "/toc\\.yml/i"
    },
    "cmake.configureOnOpen": false,
    "cmake.configureOnEdit": false,
    "cmake.cmakePath": "C:\\Program Files\\CMake\\bin\\cmake.EXE",
    "files.associations": {
        "*.py": "python"
    },

    // "terminal.integrated.fontSize": 13,
    "go.toolsManagement.autoUpdate": true,
    "maui.configuration.androidSdkPreferredPath": "/${userHome}/Android/Sdk",
    "editor.minimap.enabled": false,
    // "editor.fontSize": 14,
    "editor.fontLigatures": "'calt', 'liga', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09'",
    "zig.zls.enabled": "on",
    "workbench.colorTheme": "GitHub Dark",
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "notebook.lineNumbers": "on",
    "jdk.jdkhome": "/usr/lib/jvm/java-21-openjdk-amd64",
    "java.jdt.ls.java.home": "/usr/lib/jvm/java-21-openjdk-amd64",
    "notebook.lineNumbers": "on",
    // "jdk.jdkhome": "C:\\Program Files\\Java\\jdk-25\\",  // using oracle java in windows
    // "java.jdt.ls.java.home": "C:\\Program Files\\Java\\jdk-25\\", // using oracle java in windows
}
